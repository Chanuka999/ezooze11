# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ezooze?retryWrites=true&w=majority

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
